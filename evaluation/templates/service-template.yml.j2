{{ node.node_name }}:
    <<: *node_base
    environment:
      AGGREGATION: "fedavg"
      DECENTRALIZED: "{{ node.decentralized }}"
      D2D: "{{ node.d2d }}"
      MOBILITY: "False"
      CLUSTERING: "none_clustering"
      OFFLOADING: "{{ node.offloading }}"
      SPLITTING_METHOD: "{{ node.splitting_method }}"
      MODEL: "VGG"
      DATASET: "cifar10"
      NODE_INDEX: "{{ node.node_index }}"
      IP: "{{ node.ip }}"
      PORT: "{{ node.port }}"
      RABBITMQ_URL: "amqp://rabbitmq:rabbitmq@broker:5672/{{ node.node_name }}"
      NEIGHBORS: "{{ node.neighbors }}"
      NODE_TYPE: "{{ node.node_type }}"
      ROUND_COUNT: "{{ node.round_count }}"
      DEVICE_COUNT: "{{ node.device_count }}"
      SCENARIO_DESCRIPTION: "{{ node.scenario_description }}"
{% if node.use_gpu %}
{% if node.gpu_device_ids != 'all' %}
      CUDA_VISIBLE_DEVICES: "{{ node.gpu_device_ids }}"
      NVIDIA_VISIBLE_DEVICES: "{{ node.gpu_device_ids }}"
      GPU_DEVICE_ID: "0"
{% else %}
      GPU_DEVICE_ID: "0"
{% endif %}
{% endif %}
    deploy:
      resources:
        limits:
          cpus: "{{ node.cpu_limit }}"
          memory: {{ node.memory_limit }}
{% if node.use_gpu %}
        reservations:
          devices:
            - driver: nvidia
{% if node.gpu_device_ids == 'all' %}
              count: all
{% else %}
              device_ids: [{% for id in node.gpu_device_ids.split(',') %}'{{ id.strip() }}'{% if not loop.last %}, {% endif %}{% endfor %}]
{% endif %}
              capabilities: [gpu]
{% endif %}
